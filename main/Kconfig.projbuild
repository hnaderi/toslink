menu "Toslink demo"

    choice TOSLINK_DEMO_ROLE
        prompt "Board role"
        default TOSLINK_DEMO_ROLE_TX
        help
            Flash one board as transmitter and the other as receiver.

        config TOSLINK_DEMO_ROLE_TX
            bool "Transmitter (drives the TOTX module)"
        config TOSLINK_DEMO_ROLE_RX
            bool "Receiver (reads the TORX module)"
    endchoice

    config TOSLINK_DEMO_TX_GPIO
        int "GPIO wired to the TOTX input"
        depends on TOSLINK_DEMO_ROLE_TX
        default 4

    config TOSLINK_DEMO_TX_INVERT
        bool "Invert TX pin (active-low, for an inverting level shifter)"
        depends on TOSLINK_DEMO_ROLE_TX
        default n

    config TOSLINK_DEMO_RX_GPIO
        int "GPIO wired to the TORX output"
        depends on TOSLINK_DEMO_ROLE_RX
        default 5

    config TOSLINK_DEMO_RX_INVERT
        bool "Invert RX pin (signal passes through an inverting buffer)"
        depends on TOSLINK_DEMO_ROLE_RX
        default n

    config TOSLINK_DEMO_SEND_PERIOD_MS
        int "Interval between demo commands (ms)"
        depends on TOSLINK_DEMO_ROLE_TX
        default 500

    config TOSLINK_DEMO_REPEATS
        int "Copies sent of each command"
        depends on TOSLINK_DEMO_ROLE_TX
        range 1 10
        default 3

endmenu
